<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.41</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <AssemblyName>QuickLauncher</AssemblyName>
    <RootNamespace>QuickLauncher</RootNamespace>
    <Version>1.1.0</Version>
    <Description>Application Launcher style Spotlight/PowerToys Run</Description>
    <StartupObject>QuickLauncher.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- L'UI est en français uniquement : inutile d'embarquer les 13 dossiers
         de ressources satellites WPF (~18 Mo dans un publish self-contained). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Requis par le source generator WinRT (WinRTGenericInstantiation.g.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 suggère SetHighDpiMode (WinForms only). Inapproprié ici :
         l'app est à base WPF, le manifest est la seule méthode qui applique
         le DPI awareness avant la création de la première fenêtre. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit (version centralisée) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    
    <!-- SQLite - Migré vers Microsoft.Data.Sqlite (plus moderne, maintenu par Microsoft) -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    
    <!-- System Tray (version centralisée) -->
    <PackageReference Include="H.NotifyIcon.Wpf" />
    
    <!-- Audio - Contrôle du volume système -->
    <PackageReference Include="NAudio" />
    
    <!-- OleDb pour Windows Search API -->
    <PackageReference Include="System.Data.OleDb" />
    
    <!-- Injection de dépendances -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    
    <!-- DPAPI - Chiffrement des données sensibles (clés API) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    
    <!-- Installateur + mises à jour automatiques (Velopack) -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- Velopack exige un Main explicite pour s'initialiser avant WPF.
       App.xaml passe donc de ApplicationDefinition (Main auto-généré) à Page,
       et le Main est défini manuellement dans App.xaml.cs. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Resources\**\*" Exclude="Resources\**\*.xaml" />
  </ItemGroup>

  <!-- Expose les membres internal au projet de tests (EscapeQuery,
       ComputeDamerauLevenshtein, MatchesInitials, IsSubsequenceMatch...). -->
  <ItemGroup>
    <InternalsVisibleTo Include="QuickLauncher.Tests" />
  </ItemGroup>

</Project>
