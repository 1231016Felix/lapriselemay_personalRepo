<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème sombre — remplace les brushes dynamiques de Styles.xaml -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252525"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E3E"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#3E3E3E"/>
    <!-- Alpha remonté de 0x44 à 0x66 : à 0x44 la ligne sélectionnée n'était qu'à
         1.33:1 du fond, toute la lisibilité reposant sur la barre d'accent de 3px.
         Régénéré depuis la couleur d'accent par ThemeService.ApplyAccentColor. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#660078D4"/>
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#1A1A1A"/>

</ResourceDictionary>
